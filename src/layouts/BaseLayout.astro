---
export interface Props {
  title: string;
  description?: string;
  theme?: 'loop77' | 'ul7r4' | 'home';
  lang?: 'en' | 'pt';
}

const { 
  title, 
  description = "LUMO Studio Platform", 
  theme = 'home', 
  lang = 'en' 
} = Astro.props;

const translations = {
  en: { home: "Home", labels: "Labels", artists: "Artists", albums: "Albums", tracks: "Tracks", videos: "Videos", about: "About", explore: "Explore" },
  pt: { home: "Início", labels: "Selos", artists: "Artistas", albums: "Álbuns", tracks: "Faixas", videos: "Vídeos", about: "Sobre", explore: "Explorar" }
};
const t = translations[lang];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | LUMO</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body class={`theme-${theme}`}>
    
    <!-- Header Global Fixo -->
    <header>
      <a href="/" class="logo">
        <!-- A imagem agora é 1200x400. A altura de 60px vai deixar a escrita no tamanho ideal -->
        <img src="https://pub-9d39f9ae84344837a517f2dfdde5f23b.r2.dev/image/label_lumo_transparent.png" alt="LUMO" style="height: 60px; width: auto; display: block;" />
      </a>
      
      <nav>
        <a href="/">{t.home}</a>
        <a href="/labels">{t.labels}</a>
        <a href="/artists">{t.artists}</a>
        <a href="/albums">{t.albums}</a>
        <a href="/tracks">{t.tracks}</a>
        <a href="/videos">{t.videos}</a>
        <a href="/about">{t.about}</a>
      </nav>

      <div class="header-right">
        <div class="search-bar">
          <input type="text" placeholder="Search..." />
        </div>
        <div class="lang-switcher">
          <a href="/" aria-label="English">EN</a>
          <a href="/pt/" aria-label="Português">PT</a>
        </div>
      </div>
    </header>

    <!-- Conteúdo Principal -->
    <main>
      <slot />
    </main>

  </body>
</html>

<style is:global>
  /* Reset e Tipografia */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  
  body { 
    font-family: 'Inter', sans-serif; 
    background: #000; 
    color: #fff; 
    overflow-x: hidden;
  }

  .font-serif {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
  }

  /* Header Global Fixo */
  header {
    position: fixed;
    top: 0; left: 0; width: 100%;
    height: 100px; /* Header alto para acomodar bem o logo e o menu */
    padding: 0 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #000; 
    border-bottom: 1px solid #222;
    z-index: 1000;
  }
  
  .logo { 
    display: flex; 
    align-items: center; 
    text-decoration: none; 
    height: 100%; 
  }

  nav { display: flex; gap: 2rem; }
  nav a { 
    color: rgba(255, 255, 255, 0.6); 
    text-decoration: none; 
    font-size: 0.85rem; 
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.3s;
  }
  nav a:hover { color: #fff; }

  .header-right { display: flex; align-items: center; gap: 2rem; }

  .search-bar input {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    color: #fff;
    padding: 0.25rem 0.5rem;
    font-size: 0.85rem;
    outline: none;
    width: 150px;
  }
  .search-bar input::placeholder { color: rgba(255,255,255,0.3); }

  .lang-switcher { 
    display: flex; gap: 0.5rem; 
    font-size: 0.85rem;
    border-left: 1px solid rgba(255,255,255,0.2);
    padding-left: 1rem;
  }
  .lang-switcher a { color: rgba(255,255,255,0.6); text-decoration: none; }
  .lang-switcher a:hover { color: #fff; }

  /* Utilitários */
  main { padding-top: 100px; }
  h1, h2, h3 { font-weight: 400; letter-spacing: -0.02em; }
</style>