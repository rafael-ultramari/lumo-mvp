
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';
import '../../styles/shared/listing.css';

const todasAsTracks = [];

for (const artista of catalogo.artistas) {
  for (const album of artista.albuns) {
    if (album.isVisible) {
      for (const track of album.tracks) {
        todasAsTracks.push({
          ...track,
          artistaNome: artista.nome,
          artistaSlug: artista.slug,
          albumSlug: album.slug,
          albumTitle: album.title,
          albumCapa: album.capa
        });
      }
    }
  }
}

const backgroundImage = todasAsTracks[0]?.albumCapa;
---

<BaseLayout title="Tracks" theme="home" lang="en">

  {backgroundImage && (
    <>
      <div
        class="listing-background"
        style={`background-image: url('${backgroundImage}')`}
      ></div>
      <div class="listing-overlay"></div>
    </>
  )}

  <div class="listing-page-container tracks-page-container">

    <h2 class="section-title">TRACKS</h2>

    <div class="listing-items tracks-list">
      {todasAsTracks.map(track => (
        <a
          href={`/tracks/${track.artistaSlug}/${track.albumSlug}/${track.slug}`}
          class="listing-row track-row"
        >

          <div class="track-image-wrapper">
            <img
              src={track.albumCapa}
              alt={track.title}
              class="listing-image"
            />
          </div>

          <div class="listing-info track-info">
            <h3 class="font-serif">{track.title}</h3>

            <p class="track-album">
              {track.artistaNome} · {track.albumTitle}
            </p>

            <div class="track-meta">
              <span>{track.duration}</span>
              <span class="meta-sep">|</span>
              <span>{track.track_subgenres.join(' · ')}</span>
            </div>
          </div>

        </a>
      ))}
    </div>

  </div>

</BaseLayout>

<style>
  :global(body) {
    overflow-y: auto;
    overflow-x: hidden;
  }

  .tracks-list {
    gap: 1.5rem;
  }

  .track-image-wrapper {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #333;
  }

  .track-info h3 {
    font-size: 1.4rem;
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
  }

  .track-album {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.5rem;
  }

  .track-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.4);
  }

  .meta-sep {
    opacity: 0.3;
  }

  @media (max-width: 768px) {
    .tracks-list {
      gap: 1.5rem;
    }

    .track-image-wrapper {
      width: 60px;
      height: 60px;
    }

    .track-info h3 {
      font-size: 1.1rem;
    }

    .track-album {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 768px) {
  .listing-row.track-row {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
  }
}
</style>
