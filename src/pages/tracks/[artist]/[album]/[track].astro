---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import catalogo from '../../../../data/catalogo.json';

export function getStaticPaths() {
  const paths = [];
  for (const artista of catalogo.artistas) {
    for (const album of artista.albuns) {
      if (album.isVisible) {
        for (const track of album.tracks) {
          paths.push({
            params: { artist: artista.slug, album: album.slug, track: track.slug },
            props: { artista, album, track }
          });
        }
      }
    }
  }
  return paths;
}

const { artista, album, track } = Astro.props;

const trackDescription = track.descricao?.en || album.descricao?.en || "No description available.";
const lyrics = track.lyrics?.en || "Lyrics not available for this track.";

const queue = album.tracks.map(t => ({
  url: t.audio,
  title: t.title,
  artist: artista.nome,
  cover: album.capa
}));
const queueJson = JSON.stringify(queue);
const currentIndex = album.tracks.findIndex(t => t.slug === track.slug);
---

<BaseLayout 
  title={track.title} 
  theme="home" 
  lang="en"
  ogImage={album.capa}
  ogType="music.song"
>
  
  <div class="track-hero-container">
    
    <div class="track-bg" style={`background-image: url('${album.capa}');`}></div>
    <div class="overlay"></div>

    <div class="track-content-wrapper">
      
      <div class="track-info-section">
        <div class="track-cover-wrapper">
          <img src={album.capa} alt={track.title} class="track-main-cover" />
        </div>

        <div class="track-text-content">
          <div class="track-text-top">
            <h1 class="font-serif">{track.title}</h1>
            <p class="track-artist">By {artista.nome}</p>
            {trackDescription && (
              <p class="track-description">{trackDescription}</p>
            )}
            <div class="track-meta-row">
              <span class="meta-item">{album.releaseYear || '2026'}</span>
              <span class="meta-sep">|</span>
              <span class="meta-item">{track.duration}</span>
              <span class="meta-sep">|</span>
              <span class="meta-item">{track.track_subgenres.join(' · ')}</span>
            </div>
          </div>

          <div class="track-actions">
            <button id="play-track-btn" class="btn-play" 
              data-audio={track.audio} 
              data-title={track.title} 
              data-artist={artista.nome} 
              data-cover={album.capa}
              data-queue={queueJson}
              data-index={currentIndex}>
              <span class="play-icon">▶</span> Play
            </button>
            
            <button id="share-btn" class="btn-icon" aria-label="Compartilhar" title="Share">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                <polyline points="16 6 12 2 8 6"></polyline>
                <line x1="12" y1="2" x2="12" y2="15"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="track-lyrics-section">
        <div class="lyrics-content">
          <p>{lyrics}</p>
        </div>
      </div>

    </div>

  </div>

</BaseLayout>

<script>
  function setupTrackPage() {
    const shareBtn = document.getElementById('share-btn');
    if (shareBtn) {
      const newShareBtn = shareBtn.cloneNode(true) as HTMLButtonElement;
      shareBtn.parentNode?.replaceChild(newShareBtn, shareBtn);
      
      newShareBtn.addEventListener('click', async () => {
        const url = window.location.href;
        const title = document.querySelector('h1')?.textContent || 'Track';
        
        if (navigator.share) {
          try {
            await navigator.share({ title: title, url: url });
          } catch (err) { console.log('Erro ao compartilhar:', err); }
        } else {
          navigator.clipboard.writeText(url);
          alert('Link copiado para a área de transferência!');
        }
      });
    }

    const playBtn = document.getElementById('play-track-btn');
    if (playBtn) {
      const newPlayBtn = playBtn.cloneNode(true) as HTMLButtonElement;
      playBtn.parentNode?.replaceChild(newPlayBtn, playBtn);
      
      newPlayBtn.addEventListener('click', (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const url = btn.getAttribute('data-audio');
        const title = btn.getAttribute('data-title');
        const artist = btn.getAttribute('data-artist');
        const cover = btn.getAttribute('data-cover');
        const queue = JSON.parse(btn.getAttribute('data-queue') || '[]');
        const index = parseInt(btn.getAttribute('data-index') || '0');

        if (url && title && artist && cover) {
          document.dispatchEvent(new CustomEvent('playTrack', {
            detail: { url, title, artist, cover, queue, index, isShuffle: false }
          }));
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', setupTrackPage);
  document.addEventListener('astro:page-load', setupTrackPage);
</script>

<style>
  :global(body) { overflow-y: auto; }

  .track-hero-container {
    position: relative;
    width: 100vw;
    /* Removido min-height: 100vh para a altura ser do conteúdo */
    display: flex;
    flex-direction: column;
    padding-top: 50px;
    padding-bottom: 70px;
  }

  .track-bg {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    filter: blur(40px) brightness(0.3);
    transform: scale(1.1);
    z-index: 0;
  }

  .overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 50%, transparent 100%);
    z-index: 1;
  }

  .track-content-wrapper {
    position: relative;
    z-index: 2;
    padding: 0 10%;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .track-info-section {
    display: flex;
    gap: 3rem;
    align-items: flex-start; 
    margin-bottom: 2rem;
  }

  .track-cover-wrapper {
    width: 280px;
    height: 280px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 10px 40px rgba(0,0,0,0.6);
  }

  .track-main-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .track-text-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 280px;
    max-width: 800px;
    padding-top: 0;
  }

  .track-text-content h1 {
    font-size: 3rem; 
    line-height: 1;
    letter-spacing: 0.02em;
    text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    margin-bottom: 0.25rem;
    margin-top: -0.2rem; 
  }

  .track-artist {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.8);
    margin-bottom: 1rem;
  }

  .track-description {
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1rem;
  }

  .track-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.5);
  }

  .meta-sep { opacity: 0.3; }

  .track-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .btn-play {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    color: #000;
    border: none;
    padding: 0.6rem 1.8rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .btn-play:hover { transform: scale(1.05); }
  .play-icon { font-size: 0.75rem; }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-icon:hover { background: rgba(255,255,255,0.2); }

  .track-lyrics-section {
    max-width: 1000px;
    background: rgba(0,0,0,0.3);
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.05);
  }

  .lyrics-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255,255,255,0.9);
    white-space: pre-wrap;
  }

  @media (max-width: 1024px) {
    .track-hero-container {
      padding-top: 50px;
      padding-bottom: 70px;
    }

    .track-content-wrapper { padding: 0 5%; }
    .track-info-section { flex-direction: column; align-items: center; text-align: center; gap: 1.5rem; }
    .track-text-content { height: auto; }
    .track-text-content h1 { font-size: 2.5rem; margin-top: 0; }
    .track-meta-row { justify-content: center; }
    .track-actions { justify-content: center; }
    .track-lyrics-section { padding: 1rem; }
  }
</style>