
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';
import '../../styles/shared/listing.css';

const artistas = catalogo.artistas;
const backgroundImage = artistas[0]?.foto;
---

<BaseLayout title="Artists" theme="home" lang="en">

  {backgroundImage && (
    <>
      <div
        class="listing-background"
        style={`background-image: url('${backgroundImage}')`}
      ></div>
      <div class="listing-overlay"></div>
    </>
  )}

  <div class="listing-page-container artists-page-container">

    <h2 class="section-title">ARTISTS</h2>

    <div class="listing-items">
      {artistas.map(artista => (
        <a href={`/artists/${artista.slug}`} class="listing-row">

          <div class="artist-image-wrapper">
            <img
              src={artista.foto}
              alt={artista.nome}
              class="listing-image"
            />
          </div>

          <div class="listing-info artist-info">
            <h3 class="font-serif">{artista.nome.toUpperCase()}</h3>
            <p class="artist-desc">{artista.descricao.en || artista.descricao.pt}</p>
            <span class="listing-cta">VIEW ARTIST &rarr;</span>
          </div>

        </a>
      ))}
    </div>

  </div>

</BaseLayout>

<style>
  :global(body) {
    overflow-y: auto;
    overflow-x: hidden;
  }

  .artist-image-wrapper {
    width: 160px;
    height: 160px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #333;
  }

  .artist-info h3 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }

  .artist-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.5rem;
    max-width: 700px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .artist-image-wrapper {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }

    .artist-info h3 {
      font-size: 2rem;
    }

    .artist-desc {
      font-size: 0.9rem;
    }
  }
</style>
