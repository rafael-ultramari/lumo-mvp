---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';
import '../../styles/pages/artist.css'; // <--- Importando o CSS externo

export function getStaticPaths() {
  return catalogo.artistas.map(artista => ({
    params: { artist: artista.slug },
    props: { artista }
  }));
}

const { artista } = Astro.props;

// Busca o nome de exibição do label a partir do slug
const label = catalogo.labels.find(l => l.slug === artista.label);
const labelNome = label ? label.nome : 'Artistas';
const labelUrl = label ? `/labels/${label.slug}` : '/artists';
---

<BaseLayout title={artista.nome} theme="home" lang="en">
  
  <div class="artist-hero-container">
    
    <div class="artist-bg" style={`background-image: url('${artista.foto}');`}></div>
    <div class="overlay"></div>

    <div class="artist-content-wrapper">
      
      <div class="artist-top-block">
        
        <a href={labelUrl} class="back-button" aria-label={`Back to ${labelNome}`} title={`Back to ${labelNome}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            width="20" height="20" aria-hidden="true">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
        </a>

        <div class="artist-info-section">
          <div class="artist-photo-wrapper">
            <img src={artista.foto} alt={artista.nome} class="artist-main-photo" />
          </div>

          <div class="artist-text-content">
            
            <!-- Agrupador: Título + Descrição -->
            <div class="artist-header-text">
              <h1 class="font-serif lining-nums">{artista.nome.toUpperCase()}</h1>
              <p class="artist-description">{artista.descricao.en || artista.descricao.pt}</p>
            </div>
            
            <!-- Info: Independente, cravada na base -->
            <div class="artist-meta-row">
              <span class="meta-item">{artista.genero.join(' · ')}</span>
              <span class="meta-sep">|</span>
              <span class="meta-item">{artista.totalAlbuns} ALBUMS</span>
              <span class="meta-sep">|</span>
              <span class="meta-item">{artista.totalFaixas} TRACKS</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Carrossel -->
      <div class="albums-carousel-section">
        <h2 class="carousel-title">Albums</h2>
        <div class="carousel-track">
          {artista.albuns.filter(album => album.isVisible).map(album => (
            <a href={`/albums/${artista.slug}/${album.slug}`} class="album-card">
              <div class="album-cover-wrapper">
                <img src={album.capa} alt={album.title} class="album-cover" />
              </div>
              <div class="album-info">
                <h3 class="font-serif">{album.title}</h3>
                <p class="album-meta">{album.releaseYear || '2026'}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>

  </div>

</BaseLayout>

<script>
  function fitWidth(el, maxHeight) {
    if (!el) return;
    
    el.style.width = 'max-content'; 
    const maxW = el.offsetWidth;
    
    el.style.width = 'min-content'; 
    const minW = el.offsetWidth;

    let lo = minW, hi = maxW;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      el.style.width = mid + 'px';
      if (el.offsetHeight > maxHeight) {
        lo = mid + 1; 
      } else {
        hi = mid;     
      }
    }
    el.style.width = lo + 'px';
  }

  function initArtistLayout() {
    const desc = document.querySelector('.artist-description');
    // Só executa no desktop para não quebrar o mobile
    if (desc && window.innerWidth > 1024) {
      fitWidth(desc, 180); // Valor 180px que você estava usando
    } else if (desc) {
      desc.style.width = '';
    }
  }

  document.addEventListener('DOMContentLoaded', initArtistLayout);
  document.addEventListener('astro:page-load', initArtistLayout);
</script>