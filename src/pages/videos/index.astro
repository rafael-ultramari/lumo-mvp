
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';
import '../../styles/shared/listing.css';

// Percorre todos os artistas e álbuns para encontrar faixas com vídeo oficial
const videos = [];

for (const artista of catalogo.artistas) {
  for (const album of artista.albuns) {
    if (album.isVisible) {
      for (const track of album.tracks) {
        if (track.hasVideo) {
          videos.push({
            ...track,
            artistaNome: artista.nome,
            artistaSlug: artista.slug,
            albumSlug: album.slug,
            albumTitle: album.title,
            albumCapa: album.capa
          });
        }
      }
    }
  }
}

const backgroundImage = videos[0]?.albumCapa;
---

<BaseLayout title="Videos" theme="home" lang="en">

  {backgroundImage && (
    <>
      <div
        class="listing-background"
        style={`background-image: url('${backgroundImage}')`}
      ></div>
      <div class="listing-overlay"></div>
    </>
  )}

  <div class="listing-page-container videos-page-container">

    <h2 class="section-title">VIDEOS</h2>

    <div class="listing-items">
      {videos.length === 0 ? (
        <p class="no-videos">No official music videos available yet.</p>
      ) : (
        videos.map(video => (
          <a
            href={`/tracks/${video.artistaSlug}/${video.albumSlug}/${video.slug}`}
            class="listing-row"
          >

            <div class="video-image-wrapper">
              <img
                src={video.albumCapa}
                alt={video.title}
                class="listing-image"
              />
              <div class="play-overlay">▶</div>
            </div>

            <div class="listing-info video-info">
              <h3 class="font-serif">{video.title.toUpperCase()}</h3>
              <p class="video-artist">By {video.artistaNome}</p>
              <p class="video-album">From the album: {video.albumTitle}</p>
              <span class="listing-cta">WATCH VIDEO &rarr;</span>
            </div>

          </a>
        ))
      )}
    </div>

  </div>

</BaseLayout>

<style>
  :global(body) {
    overflow-y: auto;
    overflow-x: hidden;
  }

  .no-videos {
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.1rem;
  }

  .video-image-wrapper {
    width: 280px;
    height: 160px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #333;
    position: relative;
  }

  .play-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.8);
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.8);
  }

  .video-info h3 {
    font-size: 2rem;
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
  }

  .video-artist {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.5rem;
  }

  .video-album {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 768px) {
    .video-image-wrapper {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .video-info h3 {
      font-size: 1.5rem;
    }
  }
</style>
