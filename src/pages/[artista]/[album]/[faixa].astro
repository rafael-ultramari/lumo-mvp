---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import catalogo from '../../../data/catalogo.json';
import AudioPlayer from '../../../components/AudioPlayer.astro';

export function getStaticPaths() {
  const paths = [];
  for (const artista of catalogo.artistas) {
    for (const album of artista.albuns) {
      if (album.isVisible) {
        for (const track of album.tracks) {
          paths.push({
            params: { artista: artista.slug, album: album.slug, faixa: track.slug },
            props: { artista, album, track }
          });
        }
      }
    }
  }
  return paths;
}

const { artista, album, track } = Astro.props;
---

<BaseLayout title={track.title} theme="loop77" lang="en">
  <div style="padding: 2rem; padding-bottom: 100px;">
    <p><a href={`/${artista.slug}/${album.slug}`}>&larr; Voltar para {album.title}</a></p>
    <h1>{track.title}</h1>
    <p>Artista: {artista.nome} | Álbum: {album.title}</p>
    <p>Duração: {track.duration}</p>
    
    <h2>Gêneros</h2>
    <p>{track.track_genres.join(', ')}</p>

    <!-- Renderiza o player com a URL real do áudio -->
    <AudioPlayer audioUrl={track.audio} trackTitle={track.title} />
  </div>
</BaseLayout>