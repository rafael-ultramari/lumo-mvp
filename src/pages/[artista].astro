---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalogo from '../data/catalogo.json';

export function getStaticPaths() {
  return catalogo.artistas.map(artista => ({
    params: { artista: artista.slug },
    props: { artista }
  }));
}

const { artista } = Astro.props;
---

<BaseLayout title={artista.nome} theme="loop77" lang="en">
  <div style="padding: 2rem;">
    <div class="artist-header">
      <img src={artista.foto} alt={artista.nome} class="artist-photo" />
      <div>
        <h1>{artista.nome}</h1>
        <p class="genres">{artista.genero.join(' · ')}</p>
      </div>
    </div>

    <h2 style="margin-top: 3rem;">Álbuns</h2>
    <div class="album-grid">
      {artista.albuns.filter(album => album.isVisible).map(album => (
        <a href={`/${artista.slug}/${album.slug}`} class="album-card">
          <img src={album.capa} alt={album.title} class="album-cover" />
          <h4>{album.title}</h4>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .artist-header {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .artist-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent-color);
  }
  .genres { opacity: 0.7; margin-top: 0.5rem; }
  .album-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 1rem;
  }
  @media (min-width: 768px) {
    .album-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .album-card {
    text-decoration: none;
    color: var(--text-color);
  }
  .album-cover {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #444;
    margin-bottom: 0.5rem;
  }
  .album-card h4 { margin: 0; font-size: 0.95rem; }
</style>