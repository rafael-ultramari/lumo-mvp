
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';
import '../../styles/shared/listing.css';

const labels = catalogo.labels;
const backgroundImage = labels[0]?.imagemFundo;
---

<BaseLayout title="Labels" theme="home" lang="en">

  {backgroundImage && (
    <>
      <div
        class="listing-background"
        style={`background-image: url('${backgroundImage}')`}
      ></div>
      <div class="listing-overlay"></div>
    </>
  )}

  <div class="listing-page-container labels-page-container">

    <h2 class="section-title">LABELS</h2>

    <div class="listing-items">
      {labels.map(label => (
        <a href={`/labels/${label.slug}`} class="listing-row">

          <div class="label-image-wrapper">
            <img
              src={label.imagemFundo}
              alt={label.nome}
              class="listing-image"
            />
          </div>

          <div class="listing-info label-info">
            <h3 class="font-serif">{label.nome.toUpperCase()}</h3>
            <p class="label-desc">{label.descricao.en || label.descricao.pt}</p>
            <span class="listing-cta">ENTER LABEL &rarr;</span>
          </div>

        </a>
      ))}
    </div>

  </div>

</BaseLayout>

<style>
  :global(body) {
    overflow-y: auto;
    overflow-x: hidden;
  }

  .label-image-wrapper {
    width: 300px;
    height: 170px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #333;
  }

  .label-info h3 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }

  .label-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.5rem;
    max-width: 700px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .label-image-wrapper {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .label-info h3 {
      font-size: 2rem;
    }

    .label-desc {
      font-size: 0.9rem;
    }
  }
</style>
