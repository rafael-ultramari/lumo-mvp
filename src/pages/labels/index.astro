---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';

const labels = catalogo.labels;
---

<BaseLayout title="Labels" theme="home" lang="en">
  
  <div class="labels-page-container">
    
    <h2 class="section-title">LABELS</h2>
    
    <div class="labels-list">
      {labels.map(label => (
        <a href={`/labels/${label.slug}`} class="label-row">
          
          <div class="label-image-wrapper">
            <img src={label.imagemFundo} alt={label.nome} class="label-image" />
          </div>

          <div class="label-info">
            <h3 class="font-serif">{label.nome.toUpperCase()}</h3>
            <p class="label-desc">{label.descricao.en || label.descricao.pt}</p>
            <span class="label-cta">ENTER LABEL &rarr;</span>
          </div>

        </a>
      ))}
    </div>

  </div>

</BaseLayout>

<style>
  :global(body) { overflow-y: auto; overflow-x: hidden; }

  .labels-page-container {
    padding-top: 50px; 
    padding-bottom: 170px; 
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 5%;
    padding-right: 5%;
  }

  .section-title {
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 2rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .labels-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .label-row {
    display: flex;
    align-items: center;
    gap: 3rem;
    text-decoration: none;
    color: #fff;
    padding: 1.5rem;
    border-radius: 8px;
    background: rgba(255,255,255,0.02);
    border: 1px solid #222;
    transition: background 0.3s, border-color 0.3s;
  }

  .label-row:hover {
    background: rgba(255,255,255,0.05);
    border-color: #555;
  }

  .label-image-wrapper {
    width: 300px;
    height: 170px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #333;
  }

  .label-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .label-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .label-info h3 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }

  .label-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
    margin-bottom: 1.5rem;
    max-width: 700px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .label-cta {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #fff;
    font-weight: 600;
    border-bottom: 1px solid #fff;
    padding-bottom: 2px;
    align-self: flex-start;
    transition: color 0.3s, border-color 0.3s;
  }

  .label-row:hover .label-cta {
    color: #ff3333;
    border-color: #ff3333;
  }

  @media (max-width: 768px) {
    .label-row { flex-direction: column; align-items: flex-start; gap: 1.5rem; padding: 1rem; }
    .label-image-wrapper { width: 100%; height: auto; aspect-ratio: 16/9; }
    .label-info h3 { font-size: 2rem; }
    .label-desc { font-size: 0.9rem; }
  }
</style>