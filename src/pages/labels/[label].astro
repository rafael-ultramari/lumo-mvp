---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';

export function getStaticPaths() {
  return catalogo.labels.map(label => ({
    params: { label: label.slug },
    props: { label }
  }));
}

const { label } = Astro.props;
---

<BaseLayout title={label.nome} theme="home" lang="en">
  
  <div class="hero-container" style={`background-image: url('${label.imagemFundo}');`}>
    
    <div class="overlay"></div>

    <div class="hero-content-wrapper">
      
      <div class="hero-header">
        <div class="title-row">
          <img src={`https://pub-9d39f9ae84344837a517f2dfdde5f23b.r2.dev/image/label_${label.slug}_transparent.png`} alt={label.nome} class="label-logo" />
          <h1 class="font-serif lining-nums">{label.nome.toUpperCase()}</h1>
        </div>
        <p class="hero-description">{label.descricao.en || label.descricao.pt}</p>
      </div>

      <div class="artists-carousel-section">
        <h2 class="carousel-title">Artists</h2>
        <div class="carousel-track">
          {label.artistas.map(artista => (
            <a href={`/artists/${artista.slug}`} class="artist-card">
              <div class="card-image-wrapper">
                <img src={artista.foto} alt={artista.nome} class="card-image" />
              </div>
              <div class="card-info">
                <h3 class="font-serif">{artista.nome.toUpperCase()}</h3>
                <p class="card-meta">{artista.genero.join(' · ')}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>

  </div>

</BaseLayout>

<style>
  :global(body) { overflow-y: auto; overflow-x: hidden; }

  .hero-container {
    position: relative;
    width: 100vw;
    /* Altura total - 160px (header + player) - 140px (padding total) */
    height: calc(100vh - 160px); 
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    padding-top: 70px; 
    padding-bottom: 70px;
  }

  .overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 40%, transparent 100%),
                linear-gradient(to right, rgba(0,0,0,0.8) 0%, transparent 60%);
    z-index: 1;
  }

  .hero-content-wrapper {
    position: relative;
    z-index: 2;
    padding: 0 5%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .hero-header {
    max-width: 700px; 
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .label-logo {
    height: 100px;
    width: auto;
  }

  .hero-header h1 {
    font-size: 5rem;
    line-height: 1;
    letter-spacing: 0.05em;
    text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
  }

  .hero-description {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    text-shadow: 1px 1px 8px rgba(0,0,0,0.9);
    max-width: 100%;
  }

  .lining-nums {
    font-variant-numeric: lining-nums;
    font-feature-settings: "lnum"; 
  }

  .artists-carousel-section {
    margin-top: auto;
  }

  .carousel-title {
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 1rem;
    color: rgba(255,255,255,0.8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 1rem;
  }

  .carousel-track::-webkit-scrollbar { display: none; }

  .artist-card {
    flex: 0 0 auto;
    width: 200px;
    text-decoration: none;
    color: #fff;
    transition: transform 0.3s ease;
  }

  .artist-card:hover {
    transform: scale(1.05);
  }

  .card-image-wrapper {
    width: 200px;
    height: 200px;
    margin-bottom: 0.75rem;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #333;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-info h3 {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
  }

  .card-meta {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 1024px) {
    .hero-container {
      height: auto;
      min-height: calc(100vh - 160px);
      padding-top: 50px;
      padding-bottom: 70px;
    }

    .title-row { 
      flex-direction: column; 
      align-items: flex-start; 
      gap: 1rem; 
    }
    
    .hero-header h1 { font-size: 3.5rem; }
    .label-logo { height: 80px; }
    .hero-description { font-size: 0.9rem; }
    
    .artist-card, .card-image-wrapper { width: 150px; }
    .card-image-wrapper { height: 150px; }
  }
</style>