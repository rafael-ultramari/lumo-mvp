---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';

export function getStaticPaths() {
  return catalogo.labels.map(label => ({
    params: { label: label.slug },
    props: { label }
  }));
}

const { label } = Astro.props;
---

<BaseLayout title={label.nome} theme="home" lang="en">
  
  <!-- Container Principal (Hero Imersivo) -->
  <div class="hero-container" style={`background-image: url('${label.imagemFundo}');`}>
    
    <!-- Degradê para garantir a leitura do texto e dos cards -->
    <div class="overlay"></div>

    <div class="hero-content">
      <!-- Logo e Título -->
      <div class="title-section">
        <img src={`https://pub-9d39f9ae84344837a517f2dfdde5f23b.r2.dev/image/label_${label.slug}_transparent.png`} alt={label.nome} class="label-logo" />
        <!-- Aplicando a classe lining-nums para os números ficarem alinhados -->
        <h1 class="font-serif lining-nums">{label.nome.toUpperCase()}</h1>
      </div>

      <!-- Descrição -->
      <p class="hero-description">{label.descricao.en || label.descricao.pt}</p>
    </div>

    <!-- Carrossel de Artistas (Estilo Netflix) -->
    <div class="artists-carousel-section">
      <h2 class="carousel-title">Artists</h2>
      
      <div class="carousel-track">
        {label.artistas.map(artista => (
          <a href={`/artists/${artista.slug}`} class="artist-card">
            <div class="card-image-wrapper">
              <img src={artista.foto} alt={artista.nome} class="card-image" />
            </div>
            <div class="card-info">
              <h3 class="font-serif">{artista.nome.toUpperCase()}</h3>
              <p class="card-meta">{artista.genero.join(' · ')}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>

</BaseLayout>

<style>
  /* Remove a barra de rolagem padrão do body nesta página */
  :global(body) {
    overflow: hidden; 
  }

  .hero-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    /* Reduzi o padding-top para trazer os artistas mais para cima */
    padding-top: 10vh; 
    /* Aumentei o padding-bottom para criar o espaço do player */
    padding-bottom: 120px; 
  }

  /* Degradê estilo Netflix (mais forte na parte de baixo onde ficam os artistas) */
  .overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 40%, transparent 100%),
                linear-gradient(to right, rgba(0,0,0,0.8) 0%, transparent 60%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 0 5%;
    max-width: 800px;
    /* Removemos o flex-grow para não empurrar os artistas para o final */
  }

  .title-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 1rem; /* Reduzi a margem para aproximar os artistas */
  }

  .label-logo {
    height: 120px; /* Mesmo tamanho da tela inicial */
    width: auto;
    margin-bottom: 0.5rem; /* Logo mais próximo ao título */
  }

  .hero-content h1 {
    font-size: 6rem;
    line-height: 1;
    letter-spacing: 0.05em;
    text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    margin-bottom: 1rem; /* Título mais próximo da descrição */
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    max-width: 600px;
    text-shadow: 1px 1px 5px rgba(0,0,0,0.8);
    margin-bottom: 1rem; /* Descrição mais próxima dos artistas */
  }

  /* Força os números a ficarem alinhados (igual à tela inicial) */
  .lining-nums {
    font-variant-numeric: lining-nums;
    font-feature-settings: "lnum"; 
  }

  /* Carrossel */
  .artists-carousel-section {
    position: relative;
    z-index: 2;
    padding: 0 5%;
    margin-top: 0; /* Removido o auto para ficar logo abaixo da descrição */
  }

  .carousel-title {
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 1rem;
    color: rgba(255,255,255,0.8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 1rem;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .artist-card {
    flex: 0 0 auto;
    width: 200px;
    text-decoration: none;
    color: #fff;
    transition: transform 0.3s ease;
  }

  .artist-card:hover {
    transform: scale(1.05);
  }

  .card-image-wrapper {
    width: 200px;
    height: 200px;
    margin-bottom: 0.75rem;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #333;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-info h3 {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
  }

  .card-meta {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero-content h1 { font-size: 3.5rem; }
    .label-logo { height: 80px; }
    .hero-description { font-size: 0.9rem; }
    .artist-card, .card-image-wrapper { width: 150px; }
    .card-image-wrapper { height: 150px; }
    .hero-container { padding-top: 12vh; padding-bottom: 80px; }
  }
</style>