---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalogo from '../data/catalogo.json';
import '../styles/pages/home.css'; // <--- Importando o CSS da Home

const labels = catalogo.labels;
---

<BaseLayout title="Home" theme="home" lang="en">
  
  <div class="home-container">
    {labels.map(label => (
      <section class="universe-section" style={`background-image: url('${label.imagemFundo}');`}>
        <div class="content">
          
          <div class="label-logo">
            <img src={`https://pub-9d39f9ae84344837a517f2dfdde5f23b.r2.dev/image/label_${label.slug}_transparent.png`} alt={label.nome} style="max-height: 120px; width: auto;" />
          </div>

          <h1 class="font-serif lining-nums">{label.nome.toUpperCase()}</h1>
          
          <a href={`/labels/${label.slug}`} class="btn-enter">Enter Universe</a>

        </div>
      </section>
    ))}
  </div>

</BaseLayout>



<div class="home-navigation" id="home-navigation">
  <button
    class="home-nav-btn"
    id="nav-up"
    type="button"
    aria-label="Universo anterior"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
      stroke="currentColor" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 14l5-5 5 5" />
    </svg>
  </button>

  <button
    class="home-nav-btn"
    id="nav-down"
    type="button"
    aria-label="Próximo universo"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
      stroke="currentColor" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 10l5 5 5-5" />
    </svg>
  </button>
</div>


<script>
  document.addEventListener('astro:page-load', () => {
    const sections = Array.from(
      document.querySelectorAll('.universe-section')
    );

    const button = document.getElementById('scroll-navigation-btn');
    const icon = document.getElementById('scroll-navigation-icon');
    const main = document.querySelector('main');

    if (!sections.length || !button || !icon || !main) return;

    let direction = 1;

    const updateNavigation = () => {
      const scrollPosition = main.scrollTop;
      const maxScroll = main.scrollHeight - main.clientHeight;

      const hasAbove = scrollPosition > 10;
      const hasBelow = scrollPosition < maxScroll - 10;

      if (!hasBelow && hasAbove) {
        direction = -1;
      } else if (!hasAbove && hasBelow) {
        direction = 1;
      }

      if (!hasAbove && !hasBelow) {
        button.style.opacity = '0';
        button.style.pointerEvents = 'none';
        return;
      }

      button.style.opacity = '1';
      button.style.pointerEvents = 'auto';

      if (direction === 1) {
        icon.innerHTML = '<path d="M7 10l5 5 5-5" />';
        button.setAttribute('aria-label', 'Próximo universo');
      } else {
        icon.innerHTML = '<path d="M17 14l-5-5-5 5" />';
        button.setAttribute('aria-label', 'Universo anterior');
      }
    };

    button.addEventListener('click', () => {
      const currentPosition = main.scrollTop;

      let targetSection;

      if (direction === 1) {
        targetSection = sections.find(
          section => section.offsetTop > currentPosition + 10
        );
      } else {
        targetSection = [...sections].reverse().find(
          section => section.offsetTop < currentPosition - 10
        );
      }

      if (!targetSection) return;

      main.scrollTo({
        top: targetSection.offsetTop,
        behavior: 'smooth'
      });
    });

    main.addEventListener('scroll', updateNavigation);

    updateNavigation();
  });
</script>


<script>
  document.addEventListener('astro:page-load', () => {
    const sections = Array.from(
      document.querySelectorAll('.universe-section')
    );

    const main = document.querySelector('main');
    const navUp = document.getElementById('nav-up');
    const navDown = document.getElementById('nav-down');

    if (!main || !navUp || !navDown || !sections.length) return;

    let currentIndex = 0;

    function updateNavigation() {
      const scrollPosition = main.scrollTop;

      // Identifica a seção atualmente visível
      sections.forEach((section, index) => {
        if (scrollPosition >= section.offsetTop - 100) {
          currentIndex = index;
        }
      });

      const isFirst = currentIndex === 0;
      const isLast = currentIndex === sections.length - 1;

      // Seta para cima: aparece se não for o primeiro
      navUp.style.display = isFirst ? 'none' : 'flex';

      // Seta para baixo: aparece se não for o último
      navDown.style.display = isLast ? 'none' : 'flex';
    }

    function scrollToSection(index) {
      if (index < 0 || index >= sections.length) return;

      main.scrollTo({
        top: sections[index].offsetTop,
        behavior: 'smooth'
      });
    }

    navUp.addEventListener('click', () => {
      scrollToSection(currentIndex - 1);
    });

    navDown.addEventListener('click', () => {
      scrollToSection(currentIndex + 1);
    });

    main.addEventListener('scroll', updateNavigation);

    updateNavigation();
  });
</script>
