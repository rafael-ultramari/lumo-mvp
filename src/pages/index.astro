---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalogo from '../data/catalogo.json';

const labels = catalogo.labels;
---

<BaseLayout title="Home" theme="home" lang="en">
  
  <div class="home-container">
    {labels.map(label => (
      <section class="universe-section" style={`background-image: url('${label.imagemFundo}');`}>
        <div class="content">
          
          <!-- Logo do Selo (usa a imagem transparente do label) -->
          <div class="label-logo">
            <img src={`https://pub-9d39f9ae84344837a517f2dfdde5f23b.r2.dev/image/label_${label.slug}_transparent.png`} alt={label.nome} style="max-height: 80px;" />
          </div>

          <!-- Nome do Universo -->
          <h1 class="font-serif">{label.nome}</h1>
          
          <!-- Botão "Enter Universe" -->
          <a href={`/labels/${label.slug}`} class="btn-enter">Enter Universe</a>

        </div>
      </section>
    ))}
  </div>

</BaseLayout>

<style>
  .home-container {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .universe-section {
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end; /* Empurra o conteúdo para baixo */
    align-items: center;       /* Centraliza horizontalmente */
    padding-bottom: 8rem;      /* AUMENTEI O ESPAÇO INFERIOR PARA 8REM */
    position: relative;
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  /* Gradiente para o texto e o botão ficarem legíveis sobre a imagem */
  .universe-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);
    z-index: 1;
  }

  .content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 2rem; /* Margem extra para garantir que não cole na borda */
  }

  .label-logo {
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    line-height: 1;
  }

  /* Botão Retangular Transparente */
  .btn-enter {
    display: inline-block;
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    border: 1px solid #fff;
    padding: 0.75rem 2.5rem;
    background: rgba(0, 0, 0, 0.4); 
    transition: all 0.3s ease;
  }

  .btn-enter:hover {
    background: #fff;
    color: #000;
  }

  @media (max-width: 768px) {
    h1 { font-size: 3rem; }
    .universe-section { padding-bottom: 4rem; } /* Ajuste para mobile */
    .label-logo img { max-height: 50px; }
  }
</style>