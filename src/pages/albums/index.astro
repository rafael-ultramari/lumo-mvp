
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';
import '../../styles/shared/listing.css';

const todosOsAlbuns = [];

for (const artista of catalogo.artistas) {
  for (const album of artista.albuns) {
    if (album.isVisible) {
      todosOsAlbuns.push({
        ...album,
        artistaNome: artista.nome,
        artistaSlug: artista.slug
      });
    }
  }
}

const backgroundImage = todosOsAlbuns[0]?.capa;
---

<BaseLayout title="Albums" theme="home" lang="en">

  {backgroundImage && (
    <>
      <div
        class="listing-background"
        style={`background-image: url('${backgroundImage}')`}
      ></div>
      <div class="listing-overlay"></div>
    </>
  )}

  <div class="listing-page-container albums-page-container">

    <h2 class="section-title">ALBUMS</h2>

    <div class="listing-items">
      {todosOsAlbuns.map(album => (
        <a
          href={`/albums/${album.artistaSlug}/${album.slug}`}
          class="listing-row"
        >

          <div class="album-image-wrapper">
            <img
              src={album.capa}
              alt={album.title}
              class="listing-image"
            />
          </div>

          <div class="listing-info album-info">
            <h3 class="font-serif">{album.title.toUpperCase()}</h3>
            <p class="album-artist">By {album.artistaNome}</p>

            <div class="album-meta">
              <span>{album.releaseYear || '2026'}</span>
              <span>{album.tracks.length} TRACKS</span>
              <span>{album.totalDuration}</span>
            </div>

            <span class="listing-cta">VIEW ALBUM &rarr;</span>
          </div>

        </a>
      ))}
    </div>

  </div>

</BaseLayout>

<style>
  :global(body) {
    overflow-y: auto;
    overflow-x: hidden;
  }

  .album-image-wrapper {
    width: 180px;
    height: 180px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #333;
  }

  .album-info h3 {
    font-size: 2.2rem;
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
  }

  .album-artist {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1rem;
  }

  .album-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 768px) {
    .album-image-wrapper {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }

    .album-info h3 {
      font-size: 1.8rem;
    }
  }
</style>
