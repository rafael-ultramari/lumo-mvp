---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogo from '../../data/catalogo.json';

const todosOsAlbuns = [];
for (const artista of catalogo.artistas) {
  for (const album of artista.albuns) {
    if (album.isVisible) {
      todosOsAlbuns.push({
        ...album,
        artistaNome: artista.nome,
        artistaSlug: artista.slug
      });
    }
  }
}
---

<BaseLayout title="Albums" theme="home" lang="en">
  
  <div class="albums-page-container">
    
    <h2 class="section-title">ALBUMS</h2>
    
    <div class="albums-list">
      {todosOsAlbuns.map(album => (
        <a href={`/albums/${album.artistaSlug}/${album.slug}`} class="album-row">
          
          <div class="album-image-wrapper">
            <img src={album.capa} alt={album.title} class="album-image" />
          </div>

          <div class="album-info">
            <h3 class="font-serif">{album.title.toUpperCase()}</h3>
            <p class="album-artist">By {album.artistaNome}</p>
            <div class="album-meta">
              <span>{album.releaseYear || '2026'}</span>
              <span>{album.tracks.length} TRACKS</span>
              <span>{album.totalDuration}</span>
            </div>
            <span class="album-cta">VIEW ALBUM &rarr;</span>
          </div>

        </a>
      ))}
    </div>

  </div>

</BaseLayout>

<style>
  :global(body) { overflow-y: auto; overflow-x: hidden; }

  .albums-page-container {
    padding-top: 50px; 
    padding-bottom: 170px; 
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 5%;
    padding-right: 5%;
  }

  .section-title {
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 2rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .albums-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .album-row {
    display: flex;
    align-items: center;
    gap: 3rem;
    text-decoration: none;
    color: #fff;
    padding: 1.5rem;
    border-radius: 8px;
    background: rgba(255,255,255,0.02);
    border: 1px solid #222;
    transition: background 0.3s, border-color 0.3s;
  }

  .album-row:hover {
    background: rgba(255,255,255,0.05);
    border-color: #555;
  }

  .album-image-wrapper {
    width: 180px;
    height: 180px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #333;
  }

  .album-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .album-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .album-info h3 {
    font-size: 2.2rem;
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
  }

  .album-artist {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.6);
    margin-bottom: 1rem;
  }

  .album-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 1.5rem;
  }

  .album-cta {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #fff;
    font-weight: 600;
    border-bottom: 1px solid #fff;
    padding-bottom: 2px;
    align-self: flex-start;
    transition: color 0.3s, border-color 0.3s;
  }

  .album-row:hover .album-cta {
    color: #ff3333;
    border-color: #ff3333;
  }

  @media (max-width: 768px) {
    .album-row { flex-direction: column; align-items: flex-start; gap: 1.5rem; padding: 1rem; }
    .album-image-wrapper { width: 100%; height: auto; aspect-ratio: 1; }
    .album-info h3 { font-size: 1.8rem; }
  }
</style>