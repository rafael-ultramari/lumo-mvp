---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import catalogo from '../../../data/catalogo.json';
import '../../../styles/pages/album.css';

export function getStaticPaths() {
  const paths = [];

  for (const artista of catalogo.artistas) {
    for (const album of artista.albuns) {
      if (album.isVisible) {
        paths.push({
          params: {
            artist: artista.slug,
            album: album.slug
          },
          props: {
            artista,
            album
          }
        });
      }
    }
  }

  return paths;
}

const { artista, album } = Astro.props;

const primeiraFaixa = album.tracks[0];

const queue = album.tracks.map((track) => ({
  url: track.audio,
  title: track.title,
  artist: artista.nome,
  cover: album.capa
}));

const queueJson = JSON.stringify(queue);
---

<BaseLayout title={album.title} theme="home" lang="en">

  <div class="album-hero-container">

    <div
      class="album-bg"
      style={`background-image: url('${album.capa}');`}
    ></div>

    <div class="overlay"></div>

    <div class="album-content-wrapper">

      <a
        href={`/artists/${artista.slug}`}
        class="back-button"
        aria-label={`Back to ${artista.nome}`}
        title={`Back to ${artista.nome}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          width="20"
          height="20"
          aria-hidden="true"
        >
          <path d="M19 12H5"></path>
          <path d="M12 19l-7-7 7-7"></path>
        </svg>
      </a>

      <div class="album-layout-grid">

        <!-- CABEÇALHO CENTRALIZADO -->
        <div class="album-header-group">

          <div class="album-title-group">
            <div class="album-title-wrapper">
              <h1 class="font-serif">{album.title.toUpperCase()}</h1>
            </div>

            <p class="album-artist">By {artista.nome}</p>
          </div>

          <!-- BOTÕES -->
          <div class="album-actions">

            {primeiraFaixa && (
              <button
                class="btn-play"
                data-audio={primeiraFaixa.audio}
                data-title={primeiraFaixa.title}
                data-artist={artista.nome}
                data-cover={album.capa}
                data-queue={queueJson}
                data-index="0"
                type="button"
              >
                <span class="play-icon">▶</span> Play
              </button>
            )}

            <button
              class="btn-icon"
              id="page-shuffle-btn"
              data-queue={queueJson}
              type="button"
              aria-label="Shuffle"
              title="Shuffle"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <polyline points="16 3 21 3 21 8"></polyline>
                <line x1="4" y1="20" x2="21" y2="3"></line>
                <polyline points="21 16 21 21 16 21"></polyline>
                <line x1="15" y1="15" x2="21" y2="21"></line>
                <line x1="4" y1="4" x2="9" y2="9"></line>
              </svg>
            </button>

            <button
              id="share-btn"
              class="btn-icon"
              type="button"
              aria-label="Compartilhar"
              title="Share"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                <polyline points="16 6 12 2 8 6"></polyline>
                <line x1="12" y1="2" x2="12" y2="15"></line>
              </svg>
            </button>

            <button
              class="btn-icon mobile-tracklist-toggle"
              type="button"
              aria-expanded="false"
              aria-label="Show tracklist"
              title="Show tracklist"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path d="M8 6h13"></path>
                <path d="M8 12h13"></path>
                <path d="M8 18h13"></path>
                <path d="M3 6h.01"></path>
                <path d="M3 12h.01"></path>
                <path d="M3 18h.01"></path>
              </svg>
            </button>

          </div>
        </div>

        <!-- COLUNA ESQUERDA: INFORMAÇÕES DO ÁLBUM -->
        <div class="album-info-section">

          <div class="album-cover-wrapper">
            <img
              src={album.capa}
              alt={album.title}
              class="album-main-cover"
            />
          </div>

          <div class="album-text-content">

            <div class="album-text-top">

              <div class="album-header-text">

                {album.descricao?.en && (
                  <p class="album-description">
                    <span class="album-description-text">
                      {album.descricao.en}
                    </span>

                    <button
                      class="album-description-more"
                      type="button"
                      aria-expanded="false"
                      hidden
                    >
                      [READ MORE]
                    </button>
                  </p>
                )}

              </div>

              <div class="album-meta-row">

                <!-- Informações principais -->
                <div class="album-meta-primary">

                  <span class="meta-item">
                    {album.releaseYear || '2026'}
                  </span>

                  <span class="meta-sep">|</span>

                  <span class="meta-item">
                    {album.tracks.length} TRACKS
                  </span>

                  <span class="meta-sep">|</span>

                  <span class="meta-item">
                    {album.totalDuration}
                  </span>

                </div>

                <!-- Gêneros -->
                <div class="album-meta-genres">
                  {album.subgenero.join(' · ')}
                </div>

              </div>

            </div>

          </div>

        </div>

        <!-- COLUNA DIREITA: TRACKLIST -->
        <div class="tracklist-section">

          <div class="tracklist">

            {album.tracks.map((track, index) => (
              <div class="track-row">

                <a
                  href={`/tracks/${artista.slug}/${album.slug}/${track.slug}`}
                  class="track-link"
                >
                  <span class="track-number">
                    {String(index + 1).padStart(2, '0')}
                  </span>

                  <div class="track-title-wrapper">

                    <span class="track-title">
                      {track.title}
                    </span>

                    {track.track_subgenres &&
                      track.track_subgenres.length > 0 && (
                        <span class="track-subgenres">
                          {track.track_subgenres.join(' · ')}
                        </span>
                      )}

                  </div>
                </a>

                <div class="track-meta">

                  <span class="track-duration">
                    {track.duration}
                  </span>

                  <button
                    class="track-play-btn"
                    type="button"
                    data-audio={track.audio}
                    data-title={track.title}
                    data-artist={artista.nome}
                    data-cover={album.capa}
                    data-queue={queueJson}
                    data-index={index}
                    aria-label={`Play ${track.title}`}
                    title="Play"
                  >
                    ▶
                  </button>

                </div>

              </div>
            ))}

          </div>

        </div>

      </div>
    </div>
  </div>

</BaseLayout>

<script>
  // Alinha o nome do artista com a última linha do título no desktop.
  function alignAlbumArtist() {
    const title = document.querySelector(
      '.album-title-group h1'
    ) as HTMLElement;

    const artist = document.querySelector(
      '.album-title-group .album-artist'
    ) as HTMLElement;

    if (!title || !artist) return;

    // Limpa os ajustes anteriores.
    title.style.width = '';
    artist.style.width = '';
    artist.style.textAlign = '';

    if (window.innerWidth <= 1024) {
      return;
    }

    const range = document.createRange();
    range.selectNodeContents(title);

    const rects = Array.from(range.getClientRects())
      .filter((rect) => rect.width > 0);

    if (!rects.length) return;

    const lastLine = rects[rects.length - 1];
    const width = lastLine.width;

    artist.style.width = `${width}px`;
    artist.style.textAlign = 'right';
  }


  // Controla a descrição do álbum no mobile.
  function setupAlbumDescription() {
    const descriptionText = document.querySelector(
      '.album-description-text'
    ) as HTMLElement;

    const readMoreBtn = document.querySelector(
      '.album-description-more'
    ) as HTMLButtonElement;

    if (!descriptionText || !readMoreBtn) return;

    const LIMIT = 86;

    const translations: Record<
      string,
      { readMore: string; readLess: string }
    > = {
      en: {
        readMore: '[READ MORE]',
        readLess: '[READ LESS]'
      },
      pt: {
        readMore: '[LER MAIS]',
        readLess: '[LER MENOS]'
      }
    };

    const language = (
      document.documentElement.lang || 'en'
    ).toLowerCase().split('-')[0];

    const labels = translations[language] || translations.en;

    const fullText =
      descriptionText.dataset.fullText ??
      descriptionText.textContent?.trim() ??
      '';

    descriptionText.dataset.fullText = fullText;

    const renderDescription = (expanded: boolean) => {

      // No desktop, a descrição permanece sempre completa.
      if (window.innerWidth > 1024) {
        descriptionText.textContent = fullText;
        readMoreBtn.hidden = true;
        readMoreBtn.dataset.expanded = 'false';
        readMoreBtn.setAttribute('aria-expanded', 'false');
        return;
      }

      // Descrições que cabem no limite não precisam do botão.
      if (Array.from(fullText).length <= LIMIT) {
        descriptionText.textContent = fullText;
        readMoreBtn.hidden = true;
        readMoreBtn.dataset.expanded = 'false';
        readMoreBtn.setAttribute('aria-expanded', 'false');
        return;
      }

      readMoreBtn.hidden = false;

      if (expanded) {
        descriptionText.textContent = `${fullText} `;
        readMoreBtn.textContent = labels.readLess;
        readMoreBtn.dataset.expanded = 'true';
        readMoreBtn.setAttribute('aria-expanded', 'true');
        return;
      }

      // O espaço e o texto do botão também entram no limite.
      const suffix = ` ${labels.readMore}`;
      const suffixLength = Array.from(suffix).length;
      const availableCharacters = LIMIT - suffixLength;

      const characters = Array.from(fullText);

      let excerpt = characters
        .slice(0, availableCharacters)
        .join('');

      // Evita cortar uma palavra no meio quando possível.
      const lastSpace = excerpt.lastIndexOf(' ');

      if (lastSpace > availableCharacters * 0.6) {
        excerpt = excerpt.slice(0, lastSpace);
      }

      descriptionText.textContent = `${excerpt.trimEnd()} `;

      readMoreBtn.textContent = labels.readMore;
      readMoreBtn.dataset.expanded = 'false';
      readMoreBtn.setAttribute('aria-expanded', 'false');
    };

    readMoreBtn.onclick = () => {
      const expanded = readMoreBtn.dataset.expanded !== 'true';

      renderDescription(expanded);
    };

    renderDescription(
      readMoreBtn.dataset.expanded === 'true'
    );
  }


  // Envia a faixa selecionada para o player global.
  function playTrack(
    url: string,
    title: string,
    artist: string,
    cover: string,
    queue: Array<{
      url: string;
      title: string;
      artist: string;
      cover: string;
    }>,
    index: number,
    isShuffle = false
  ) {
    if (!url || !title || !artist || !cover) return;

    document.dispatchEvent(
      new CustomEvent('playTrack', {
        detail: {
          url,
          title,
          artist,
          cover,
          queue,
          index,
          isShuffle
        }
      })
    );
  }


  // Configura os controles da página do álbum.
  function setupAlbumPage() {

    // Compartilhamento.
    const shareBtn = document.getElementById(
      'share-btn'
    ) as HTMLButtonElement | null;

    if (shareBtn) {
      shareBtn.onclick = async () => {
        const url = window.location.href;
        const title =
          document.querySelector('h1')?.textContent?.trim() || 'Album';

        if (navigator.share) {
          try {
            await navigator.share({ title, url });
          } catch (err) {
            console.log('Erro ao compartilhar:', err);
          }
        } else {
          try {
            await navigator.clipboard.writeText(url);
            alert('Link copiado para a área de transferência!');
          } catch (err) {
            console.error('Erro ao copiar o link:', err);
          }
        }
      };
    }


    // Reprodução da primeira faixa.
    const playBtn = document.querySelector(
      '.btn-play'
    ) as HTMLButtonElement | null;

    if (playBtn) {
      playBtn.onclick = () => {
        const url = playBtn.getAttribute('data-audio');
        const title = playBtn.getAttribute('data-title');
        const artist = playBtn.getAttribute('data-artist');
        const cover = playBtn.getAttribute('data-cover');
        const queue = JSON.parse(
          playBtn.getAttribute('data-queue') || '[]'
        );
        const index = Number.parseInt(
          playBtn.getAttribute('data-index') || '0',
          10
        );

        if (url && title && artist && cover) {
          playTrack(
            url,
            title,
            artist,
            cover,
            queue,
            index
          );
        }
      };
    }


    // Reprodução aleatória.
    const shuffleBtn = document.getElementById(
      'page-shuffle-btn'
    ) as HTMLButtonElement | null;

    if (shuffleBtn) {
      shuffleBtn.onclick = () => {
        const queueAttr = shuffleBtn.getAttribute('data-queue');

        if (!queueAttr) return;

        const queue = JSON.parse(queueAttr);

        if (!queue.length) return;

        const shuffled = [...queue];

        for (let i = shuffled.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));

          [shuffled[i], shuffled[j]] = [
            shuffled[j],
            shuffled[i]
          ];
        }

        const randomTrack = shuffled[0];

        playTrack(
          randomTrack.url,
          randomTrack.title,
          randomTrack.artist,
          randomTrack.cover,
          shuffled,
          0,
          true
        );
      };
    }


    // Reprodução individual das faixas da tracklist.
    const playTrackBtns = document.querySelectorAll(
      '.track-play-btn'
    );

    playTrackBtns.forEach((btn) => {
      const button = btn as HTMLButtonElement;

      button.onclick = (event) => {
        event.preventDefault();

        const url = button.getAttribute('data-audio');
        const title = button.getAttribute('data-title');
        const artist = button.getAttribute('data-artist');
        const cover = button.getAttribute('data-cover');
        const queue = JSON.parse(
          button.getAttribute('data-queue') || '[]'
        );
        const index = Number.parseInt(
          button.getAttribute('data-index') || '0',
          10
        );

        if (url && title && artist && cover) {
          playTrack(
            url,
            title,
            artist,
            cover,
            queue,
            index
          );
        }
      };
    });


    // Descrição expansível no mobile.
    setupAlbumDescription();


    // Abrir e fechar a tracklist no mobile.
    const tracklistToggle = document.querySelector(
      '.mobile-tracklist-toggle'
    ) as HTMLButtonElement | null;

    const tracklistSection = document.querySelector(
      '.tracklist-section'
    ) as HTMLElement | null;

    if (tracklistToggle && tracklistSection) {
      tracklistToggle.onclick = () => {
        const expanded = tracklistSection.classList.toggle(
          'is-open'
        );

        tracklistToggle.setAttribute(
          'aria-expanded',
          String(expanded)
        );

        const label = expanded
          ? 'Hide tracklist'
          : 'Show tracklist';

        tracklistToggle.setAttribute('aria-label', label);
        tracklistToggle.setAttribute('title', label);
      };
    }
  }


  // Inicialização da página.
  document.addEventListener('DOMContentLoaded', () => {
    setupAlbumPage();
    alignAlbumArtist();
  });

  document.addEventListener('astro:page-load', () => {
    setupAlbumPage();
    alignAlbumArtist();
  });


  // Recalcula os ajustes quando a largura da tela muda.
  window.addEventListener('resize', () => {
    alignAlbumArtist();
    setupAlbumDescription();
  });
</script>